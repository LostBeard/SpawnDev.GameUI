<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>SpawnDev.GameUI</RootNamespace>
		<Version>1.1.1</Version>
		<Authors>LostBeard</Authors>
		<Title>SpawnDev.GameUI</Title>
		<Description>GPU-rendered game UI library for .Net WebAssembly. Supports screen-space 2D, world-space 3D, VR/AR, with mouse, keyboard, gamepad, VR controller, and hand tracking input. Built on SpawnDev.SpawnJS and WebGPU.</Description>
		<PackageTags>blazor;webassembly;webgpu;ui;gameui;vr;ar;webxr;gpu;spawnjs</PackageTags>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.GameUI</PackageProjectUrl>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.GameUI</RepositoryUrl>
		<License>MIT</License>
		<PackageReleaseNotes>1.1.1: UIHoldButton (press-and-hold); UIAnchorPanel.SetAnchor (move an anchored child, draw order kept); UIRenderer.DrawImage with a source rect and a tint (one sprite of an atlas); UIMinimapFrame.Markers; UILabel and UITextBlock follow the theme's text color unless given one; SpawnDev.SpawnJS.Blazor 3.0.8. See CHANGELOG.md.</PackageReleaseNotes>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon-128.png</PackageIcon>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
		<IsPackable>true</IsPackable>
		<LangVersion>latest</LangVersion>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<ItemGroup>
		<!-- Tests simulate input (GameInput's key setters are internal). -->
		<InternalsVisibleTo Include="SpawnDev.GameUI.Demo.Shared" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="SpawnDev.SpawnJS.Blazor" Version="3.0.8" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\icon-128.png" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
