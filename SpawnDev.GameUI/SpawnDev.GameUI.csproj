<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>SpawnDev.GameUI</RootNamespace>
		<Version>0.1.0-rc.3</Version>
		<Authors>LostBeard</Authors>
		<Title>SpawnDev.GameUI</Title>
		<Description>GPU-rendered game UI library for .Net WebAssembly. Supports screen-space 2D, world-space 3D, VR/AR, with mouse, keyboard, gamepad, VR controller, and hand tracking input. Built on SpawnDev.SpawnJS and WebGPU.</Description>
		<PackageTags>blazor;webassembly;webgpu;ui;gameui;vr;ar;webxr;gpu;spawnjs</PackageTags>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.VoxelEngine</PackageProjectUrl>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.GameUI</RepositoryUrl>
		<License>MIT</License>
		<PackageReleaseNotes>Package update</PackageReleaseNotes>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon-128.png</PackageIcon>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
		<IsPackable>true</IsPackable>
		<LangVersion>latest</LangVersion>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SpawnDev.SpawnJS.Blazor" Version="2.1.18" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\icon-128.png" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
