@page "/gallery"
@using SpawnDev.SpawnJS
@using SpawnDev.SpawnJS.JSObjects
@using SpawnDev.GameUI
@using SpawnDev.GameUI.Elements
@using SpawnDev.GameUI.Input
@using SpawnDev.GameUI.Animation
@using SpawnDev.GameUI.Rendering
@implements IDisposable
@inject SpawnJSRuntime JS

<PageTitle>SpawnDev.GameUI - Element Gallery</PageTitle>

<h3>Element Gallery</h3>
<p style="color: #94a3b8;">WebGPU-rendered UI elements. All drawn on the canvas below - no HTML overlays. Click and drag the controls.</p>

<div style="margin: 1rem 0;">
    <label style="color: #94a3b8; margin-right: 1rem;">Theme:</label>
    <button class="btn btn-sm @(_currentTheme == "dark" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => SetTheme("dark")'>Dark</button>
    <button class="btn btn-sm @(_currentTheme == "lost" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => SetTheme("lost")'>Lost Spawns</button>
    <button class="btn btn-sm @(_currentTheme == "aubs" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => SetTheme("aubs")'>AubsCraft</button>
</div>

<canvas @ref="_canvasRef" width="800" height="600"
        style="border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; background: #0a0a12; display: block; touch-action: none;" />

<div style="margin-top: 0.5rem; color: #64748b; font-size: 0.85rem;">
    <span>Status: @_status</span>
</div>

@code {
    private const int CanvasW = 800;
    private const int CanvasH = 600;

    private ElementReference _canvasRef;
    private string _status = "Initializing WebGPU...";
    private string _currentTheme = "dark";
    private bool _initialized;

    // Owned for page lifetime - must NOT be in a using that ends before the rAF loop
    private GPUDevice? _device;
    private GPUQueue? _queue;
    private HTMLCanvasElement? _canvas;
    private GPUCanvasContext? _gpuCtx;
    private Window? _window;
    private FontAtlas? _fontAtlas;
    private GameInput? _gameInput;
    private MouseKeyboardProvider? _mkProvider;
    private UIRenderer? _renderer;
    private UIElement? _rootElement;
    private UIButton? _clickButton;
    private UISlider? _volumeSlider;
    private int _clickCount;

    // Render loop
    private bool _loopRunning;
    private ActionCallback<double>? _rafCallback;
    private double _lastFrameTime;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;
        _initialized = true;

        try
        {
            using var gpu = JS.Get<GPU?>("navigator.gpu");
            if (gpu == null)
            {
                _status = "WebGPU not available in this browser.";
                StateHasChanged();
                return;
            }

            using var adapter = await gpu.RequestAdapter();
            if (adapter == null)
            {
                _status = "No WebGPU adapter found.";
                StateHasChanged();
                return;
            }

            _device = await adapter.RequestDevice();
            _queue = _device.Queue;

            _canvas = _canvasRef.As<HTMLCanvasElement>();
            _gpuCtx = _canvas.GetContext<GPUCanvasContext>("webgpu");
            var format = gpu.GetPreferredCanvasFormat();
            _gpuCtx.Configure(new GPUCanvasConfiguration
            {
                Device = _device,
                Format = format,
                AlphaMode = "premultiplied",
            });

            _gameInput = new GameInput();
            _mkProvider = new MouseKeyboardProvider();
            _mkProvider.Attach(_canvas);
            _gameInput.AddProvider(_mkProvider);

            _renderer = new UIRenderer();
            _fontAtlas = new FontAtlas();
            _fontAtlas.Init(_device, _queue);
            _renderer.Init(_device, _queue, _fontAtlas, format);

            BuildDemoUI();

            _status = "Ready - interact with the canvas controls.";
            StateHasChanged();

            _window = new Window();
            _rafCallback = new ActionCallback<double>(OnAnimationFrame);
            _loopRunning = true;
            _lastFrameTime = 0;
            _window.RequestAnimationFrame(_rafCallback);
        }
        catch (Exception ex)
        {
            _status = $"Error: {ex.Message}";
            StateHasChanged();
        }
    }

    private void OnAnimationFrame(double timestamp)
    {
        if (!_loopRunning || _device == null || _queue == null || _gpuCtx == null
            || _renderer == null || _gameInput == null || _rootElement == null)
            return;

        float dt = _lastFrameTime > 0 ? (float)((timestamp - _lastFrameTime) / 1000.0) : 1f / 60f;
        _lastFrameTime = timestamp;
        if (dt > 0.1f) dt = 0.1f;

        try
        {
            _gameInput.Poll();
            TweenManager.Global.Update(dt);
            _rootElement.Update(_gameInput, dt);

            if (_volumeSlider != null)
                _status = $"Volume={_volumeSlider.Value:0.00}  clicks={_clickCount}";

            using var texture = _gpuCtx.GetCurrentTexture();
            using var textureView = texture.CreateView();
            using var encoder = _device.CreateCommandEncoder();

            using var clearPass = encoder.BeginRenderPass(new GPURenderPassDescriptor
            {
                ColorAttachments = new[]
                {
                    new GPURenderPassColorAttachment
                    {
                        View = textureView,
                        LoadOp = GPULoadOp.Clear,
                        StoreOp = GPUStoreOp.Store,
                        ClearValue = new GPUColorDict { R = 0.04, G = 0.04, B = 0.07, A = 1.0 },
                    }
                }
            });
            clearPass.End();

            _renderer.Begin(CanvasW, CanvasH);
            _rootElement.Draw(_renderer);
            _renderer.End(encoder, textureView);

            using var commandBuffer = encoder.Finish();
            _queue.Submit(new[] { commandBuffer });
        }
        catch (Exception ex)
        {
            _loopRunning = false;
            _status = $"Render error: {ex.Message}";
            // Cannot StateHasChanged from arbitrary JS callback reliably - status updates next Blazor event
            Console.WriteLine($"[Gallery] {ex}");
            return;
        }

        _window?.RequestAnimationFrame(_rafCallback!);
    }

    private void BuildDemoUI()
    {
        var root = new UIAnchorPanel { Width = CanvasW, Height = CanvasH };

        var title = new UILabel { Text = "SpawnDev.GameUI Gallery", FontSize = FontSize.Title };
        root.AddAnchored(title, Anchor.TopCenter, offsetY: 20);

        var controls = new UIFlexPanel
        {
            Direction = FlexDirection.Column,
            Gap = 10,
            Width = 250,
            BackgroundColor = System.Drawing.Color.FromArgb(180, 20, 20, 35),
        };
        controls.AddChild(new UILabel { Text = "Controls", FontSize = FontSize.Heading });

        _clickButton = new UIButton { Text = "Click Me", Width = 220, Height = 36 };
        _clickButton.OnClick = () =>
        {
            _clickCount++;
            _clickButton.Text = $"Clicked {_clickCount}";
        };
        controls.AddChild(_clickButton);

        controls.AddChild(new UICheckbox { Text = "Enable VSync", Width = 220, Height = 24 });
        controls.AddChild(new UIToggle { Text = "Dark Mode" });
        _volumeSlider = new UISlider { Label = "Volume", Width = 220, Height = 40, Value = 0.7f };
        controls.AddChild(_volumeSlider);
        controls.AddChild(new UISeparator { Width = 220 });
        controls.AddChild(new UISlider { Label = "FOV", Width = 220, Height = 40, MinValue = 60, MaxValue = 120, Value = 90 });
        root.AddAnchored(controls, Anchor.TopLeft, offsetX: 20, offsetY: 70);

        var gamePanel = new UIFlexPanel
        {
            Direction = FlexDirection.Column,
            Gap = 10,
            Width = 250,
            BackgroundColor = System.Drawing.Color.FromArgb(180, 20, 20, 35),
        };
        gamePanel.AddChild(new UILabel { Text = "Game UI", FontSize = FontSize.Heading });

        gamePanel.AddChild(new UIProgressBar
        {
            Width = 220, Height = 22,
            Value = 0.75f,
            Label = "HP",
            ShowPercentage = true,
            LowColor = System.Drawing.Color.Orange,
            CriticalColor = System.Drawing.Color.Red,
        });
        gamePanel.AddChild(new UIProgressBar
        {
            Width = 220, Height = 18,
            Value = 0.45f,
            Label = "Stamina",
            FillColor = System.Drawing.Color.FromArgb(255, 80, 200, 120),
        });

        gamePanel.AddChild(new UISeparator { Width = 220 });
        gamePanel.AddChild(new UILabel { Text = "Inventory (6x3)", FontSize = FontSize.Body });

        var grid = new UIGrid { Columns = 6, Rows = 3, CellSize = 34, CellGap = 3 };
        grid.AutoSizeGrid();
        grid.SetCell(0, label: "Axe");
        grid.SetCell(1, label: "Wood", labelColor: System.Drawing.Color.FromArgb(255, 139, 90, 43));
        grid.SetCell(2, label: "Stone");
        grid.SetCell(6, label: "Rope");
        grid.SetCell(7, label: "Cloth");
        grid.SetCell(12, label: "Med");
        gamePanel.AddChild(grid);

        root.AddAnchored(gamePanel, Anchor.TopRight, offsetX: -20, offsetY: 70);

        root.AddAnchored(new UITextInput
        {
            Width = 400, Height = 32,
            Placeholder = "Type a message...",
        }, Anchor.BottomCenter, offsetY: -20);

        _rootElement = root;
    }

    private void SetTheme(string theme)
    {
        _currentTheme = theme;
        UITheme.Current = theme switch
        {
            "lost" => UITheme.LostSpawns,
            "aubs" => UITheme.AubsCraft,
            _ => UITheme.Dark,
        };
        StateHasChanged();
    }

    public void Dispose()
    {
        _loopRunning = false;
        _rafCallback?.Dispose();
        _rafCallback = null;
        _mkProvider?.Dispose();
        _mkProvider = null;
        _renderer?.Dispose();
        _renderer = null;
        _fontAtlas?.Dispose();
        _fontAtlas = null;
        _gpuCtx?.Dispose();
        _gpuCtx = null;
        _canvas?.Dispose();
        _canvas = null;
        _queue?.Dispose();
        _queue = null;
        _device?.Dispose();
        _device = null;
        _window?.Dispose();
        _window = null;
    }
}
