<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SpawnDev.GameUI</RootNamespace>

    <!-- NuGet package metadata -->
    <PackageId>SpawnDev.GameUI</PackageId>
    <Version>0.1.0-rc.2</Version>
    <Authors>LostBeard</Authors>
    <Description>GPU-rendered game UI library for Blazor WebAssembly. Supports screen-space 2D, world-space 3D, VR/AR, with mouse, keyboard, gamepad, VR controller, and hand tracking input. Built on SpawnDev.SpawnJS and WebGPU.</Description>
    <PackageTags>blazor;webassembly;webgpu;ui;gameui;vr;ar;webxr;gpu;spawnjs</PackageTags>
    <RepositoryUrl>https://github.com/LostBeard/SpawnDev.GameUI</RepositoryUrl>
    <License>MIT</License>
    <PackageReleaseNotes>Port from SpawnDev.BlazorJS 3.5.1 to SpawnDev.SpawnJS.Blazor 2.1.18. FontAtlas uploads ImageData via WriteTexture with no ReadBytes().</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SpawnDev.SpawnJS.Blazor" Version="2.1.18" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
